---
interface Props {
  /** Renders an `<a>` when set, otherwise a `<button>`. */
  href?: string;
  variant?: "default" | "suggested" | "dark";
  /** Square corners instead of the default pill. */
  square?: boolean;
  /** Full-width, centred block. */
  standalone?: boolean;
  class?: string;
  type?: "button" | "submit" | "reset";
  [key: string]: unknown;
}

const {
  href,
  variant = "default",
  square = false,
  standalone = false,
  class: className,
  type,
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";
---

<Tag
  class:list={["btn", variant !== "default" && variant, square && "square", standalone && "standalone", className]}
  href={href}
  type={Tag === "button" ? (type ?? "button") : undefined}
  {...rest}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-block;
    min-width: 4rem;
    max-width: 20rem;
    padding: 0.6rem 1.5rem;
    margin: 0.3rem;
    font-size: 1rem;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    vertical-align: middle;
    color: var(--btn-fg);
    background-color: var(--btn-bg);
    border-radius: var(--pill);
    transition: box-shadow 200ms var(--slickease);
  }

  .btn:hover {
    box-shadow: 0 0 0 2px var(--btn-bg);
    text-decoration: none;
  }

  .btn.dark {
    color: var(--btn-fg-dark);
    background-color: var(--btn-bg-dark);
  }

  .btn.dark:hover {
    box-shadow: 0 0 0 2px var(--btn-bg-dark);
  }

  .btn.standalone {
    display: block;
    max-width: 18ch;
    margin: 1rem auto;
    padding: 0.6rem 2rem;
  }

  .btn.suggested {
    color: var(--light1);
    background-color: var(--blue3);
    font-weight: 700;
  }

  .btn.suggested:hover {
    background-color: var(--blue2);
    box-shadow: 0 0 0 2px var(--blue3);
  }

  .btn.square {
    border-radius: var(--radius-small);
  }

  /* The wrapping <p> lives in a parent component, so keep it global. */
  :global(p) > .btn {
    margin-right: 0.5rem;
  }
</style>
