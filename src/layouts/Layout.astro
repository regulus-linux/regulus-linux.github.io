---
import "../styles/variables.css";
import "../styles/reset.css";
import "../styles/globals.css";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Regulus",
  description = "Regulus is a simple GTK4 Libadwaita app to run Windows apps on your Linux desktop.",
  ogImage = "/img/hero.svg",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head class="notranslate">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content="Regulus" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />

    <link rel="preconnect" href="https://static.gnome.org" crossorigin />
    <link rel="stylesheet" href="https://static.gnome.org/css/inter.css" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/img/appicon.svg" />
    <meta name="generator" content={Astro.generator} />
  </head>

  <body>
    <slot />
    <Footer />
  </body>
</html>
